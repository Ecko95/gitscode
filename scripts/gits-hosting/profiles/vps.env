# VPS scale profile — source before calling install-gits-user-service.sh
# Sized for a dedicated 32 GB Linux host; WSL defaults stay in common.sh.
# Usage: set -a; source scripts/gits-hosting/profiles/vps.env; set +a
#   then: scripts/gits-hosting/install-gits-user-service.sh --start

# systemd MemoryMax= for the service cgroup.
# 24 GB leaves ~8 GB for OS, Tailscale, and MCP sidecar processes on a 32 GB host.
GITS_HOSTING_MEMORY_MAX=24G

# Node --max-old-space-size (MiB).  Must stay below GITS_HOSTING_MEMORY_MAX.
# 16 GB gives the V8 heap room for large concurrent conversation histories.
GITS_HOSTING_NODE_HEAP_MB=16384

# Automode driver poll cadence (milliseconds).
# Default 5000 ms is conservatively slow; 2000 ms halves reaction latency on
# a host that has CPU headroom and never competes with a Windows desktop load.
GITS_AUTOMODE_DRIVER_TICK_MS=2000
